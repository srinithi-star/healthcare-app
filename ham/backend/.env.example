# ---------- Server ----------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------- Database ----------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_appointments"

# ---------- Auth ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- LLM (Anthropic) ----------
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# If unset, LLM features degrade gracefully (see services/llmService.js)

# ---------- Email (SMTP via Nodemailer) ----------
# Works with SendGrid, Mailgun, Gmail SMTP relay, or any SMTP provider.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM="Clinic Appointments <no-reply@yourclinic.example>"

# ---------- Google Calendar OAuth 2.0 ----------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# ---------- Background jobs ----------
# Cron expression for the reminder/retry sweep (default: every 5 minutes)
REMINDER_CRON="*/5 * * * *"
# How long a slot HOLD is valid for before it's released back to the pool
SLOT_HOLD_MINUTES=5
# Hours before an appointment to send the visit reminder
APPOINTMENT_REMINDER_HOURS=24
